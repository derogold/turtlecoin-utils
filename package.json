    {
      "name": "zpalmtree",
      "email": "22151537+zpalmtree@users.noreply.github.com"
    },
    {
      "name": "Leo Stehlik - not associated with any crypto"
    }
  ],
  "license": "GPL-3.0",
  "optionalDependencies": {
    "turtlecoin-crypto": "npm:@leocuvee/turtlecoin-crypto@1.0.0"
  },
  "dependencies": {
